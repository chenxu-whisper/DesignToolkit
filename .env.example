# Replace this value with a domain whose A/AAAA record points to the VPS.
DOMAIN=tools.example.com

# Hosted safety limits. Byte values use exact integer counts.
DESIGNTOOLKIT_MAX_UPLOAD_BYTES=524288000
DESIGNTOOLKIT_MAX_SESSION_BYTES=2147483648
DESIGNTOOLKIT_MAX_OUTPUT_BYTES=5368709120
DESIGNTOOLKIT_MIN_FREE_BYTES=5368709120
DESIGNTOOLKIT_MAX_QUEUED_TASKS=20
DESIGNTOOLKIT_MAX_UPLOAD_CONCURRENCY=4
DESIGNTOOLKIT_MAX_PREVIEW_CONCURRENCY=2
DESIGNTOOLKIT_MAX_IMAGE_PIXELS=100000000
DESIGNTOOLKIT_MAX_VIDEO_WIDTH=3840
DESIGNTOOLKIT_MAX_VIDEO_HEIGHT=2160
DESIGNTOOLKIT_MAX_VIDEO_DURATION_SECONDS=1800
DESIGNTOOLKIT_UPLOAD_REQUESTS_PER_HOUR=30
DESIGNTOOLKIT_API_REQUESTS_PER_MINUTE=120
DESIGNTOOLKIT_RETENTION_SECONDS=7200

# Per-service container resource limits.
APP_CPUS=1.0
APP_MEMORY=1536m
APP_PIDS=256
WORKER_CPUS=3.0
WORKER_MEMORY=5g
WORKER_PIDS=256
REDIS_CPUS=0.5
REDIS_MEMORY=512m
REDIS_PIDS=128
CLEANUP_CPUS=0.25
CLEANUP_MEMORY=256m
CLEANUP_PIDS=128
CADDY_CPUS=0.25
CADDY_MEMORY=256m
CADDY_PIDS=128
